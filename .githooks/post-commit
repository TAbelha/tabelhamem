#!/usr/bin/env bash
# Garante que o comando `tamem` (v2, TypeScript) esteja instalado em
# ~/.local/bin após cada commit. O binário Go do tamem v1 foi descontinuado;
# este hook só reinstala o wrapper, sem compilar nada.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
target="$HOME/.local/bin/tamem"

cat > "$target" <<EOF
#!/usr/bin/env bash
# tamem v2: CLI/IPC + TUI do tabelhamem (TypeScript).
set -euo pipefail
BUN_BIN="/home/ianptkcs/.local/share/mise/installs/bun/latest/bin/bun"
exec "\$BUN_BIN" "$repo_root/packages/ipc/src/cli.ts" "\$@"
EOF
chmod +x "$target"
echo "post-commit: reinstalled $target (tamem v2 wrapper)"
